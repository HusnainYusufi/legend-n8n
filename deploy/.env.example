# Copy this file to .env on the server and fill in real values.
#   cp .env.example .env
# The real .env is gitignored — never commit secrets.

# ── Public domain ───────────────────────────────────────────────
# Must have a DNS A record pointing at this VPS's public IP.
DOMAIN=n8n.yourdomain.com

# ── Postgres database ───────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=n8n

# ── n8n encryption key ──────────────────────────────────────────
# Encrypts saved credentials. Generate once with:
#   openssl rand -hex 24
# BACK THIS UP. If you lose it, all stored credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-24-output

# ── Timezone ────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Karachi
